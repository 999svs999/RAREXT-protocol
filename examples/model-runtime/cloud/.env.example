# The remote engine. No weights are downloaded and no inference runs here.
RAREXT_CLOUD_ENDPOINT=https://api.provider.example
RAREXT_CLOUD_MODEL=provider-model-id
RAREXT_CLOUD_ENGINE=openai-compatible
RAREXT_CLOUD_API=openai
RAREXT_UPSTREAM_API_KEY=

# The RAREXT services this deployment uses. Point them at a remote node and
# verifier; the control plane does not need a local registry.
RAREXT_REGISTRY_URL=https://registry.example.com
RAREXT_VERIFIER_URL=https://verifier.example.com/verify

# Optional: serve a published card instead of deploying. Use with
# compose.adopt.yml; the value is a verified deployment digest or id.
RAREXT_DEPLOYMENT=

# The public gateway. Clients send Authorization: Bearer $RAREXT_GATEWAY_TOKEN.
RAREXT_PUBLIC_URL=https://ai.example.com
RAREXT_GATEWAY_TOKEN=

# Only needed for the optional `tls` profile.
RAREXT_PUBLIC_HOST=ai.example.com
