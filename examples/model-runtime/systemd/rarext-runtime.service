# Linux supervisor for rarext-runtime.
#
# Install:
#   sudo cp examples/model-runtime/systemd/rarext-runtime.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rarext-runtime
#
# Replace __REPO__, __STATE__, and User=. The engine (Ollama, Strata, FreeToken)
# must already be running and listening on loopback.

[Unit]
Description=RAREXT model runtime — attested local inference
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=rarext
WorkingDirectory=__REPO__
ExecStart=/usr/bin/node __REPO__/apps/runtime/src/cli.ts serve \
  --manifest __STATE__/deployment.json \
  --state __STATE__ \
  --publish \
  --registry http://127.0.0.1:8787 \
  --host 127.0.0.1 \
  --port 8790
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__STATE__

[Install]
WantedBy=multi-user.target
