{
  "name": "rarext-protocol",
  "version": "0.1.0-alpha.3",
  "private": true,
  "type": "module",
  "description": "The RAREXT protocol and infrastructure for verifiable builds: artifacts, claims, verifiers, and a portable registry for AI agents and builders.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:web",
    "build:web": "esbuild apps/web/src/main.ts --bundle --format=esm --outfile=apps/web/public/app.js --sourcemap && esbuild apps/web/src/verify.ts --bundle --format=esm --outfile=apps/web/public/verify.js --sourcemap",
    "build:packages": "node scripts/build-packages.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "pack:all": "npm run build:packages && node scripts/pack-all.mjs",
    "dev": "npm run build:web && node apps/api/src/server.ts",
    "dev:api": "node apps/api/src/server.ts",
    "dev:examples": "bash scripts/dev-examples.sh",
    "dev:mcp": "node apps/mcp/src/server.ts",
    "start": "npm run build:web && node apps/api/src/server.ts",
    "test": "node --test packages/core/test/*.test.ts packages/agent-sdk/test/*.test.ts apps/api/test/*.test.ts apps/web/test/*.test.ts apps/chain/test/*.test.ts bench/storage/test/*.test.mjs bench/repair/test/*.test.mjs contracts/test/*.test.mjs",
    "test:examples": "python3 -m unittest discover -s examples/board-games -p 'test_*.py' && python3 -m unittest discover -s examples/launchpad -p 'test_*.py' && python3 -m unittest discover -s examples/storage -p 'test_*.py' && python3 -m unittest discover -s examples/market -p 'test_*.py'",
    "test:games": "npm run test:examples",
    "version:all": "node scripts/sync-version.mjs",
    "mirror:build": "node scripts/build-mirror.mjs",
    "publish:proof": "node scripts/publish-proof.mjs",
    "deploy:site": "node scripts/deploy-site.mjs",
    "backup:create": "node scripts/backup.mjs create",
    "backup:verify": "node scripts/backup.mjs verify",
    "backup:restore": "node scripts/backup.mjs restore",
    "plan:game-state": "node scripts/plan-game-state-migration.mjs",
    "test:takedown": "node scripts/takedown-test.mjs",
    "demo:durability": "node scripts/durability-demo.mjs",
    "example:mcp-storage": "node --experimental-strip-types examples/mcp-storage/main.ts",
    "example:external-agent": "node --experimental-strip-types examples/external-agent/main.ts",
    "example:sealed-storage": "node --experimental-strip-types examples/sealed-storage/main.ts",
    "bench:storage": "node bench/storage/cli.mjs",
    "bench:throughput": "node --expose-gc bench/storage/throughput.mjs",
    "bench:network": "node bench/storage/network.mjs",
    "bench:soak": "node --expose-gc bench/storage/soak.mjs",
    "bench:repair": "node bench/repair/repair-bandwidth.mjs",
    "holder": "node apps/api/src/holder-server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build:web",
    "ci": "bash scripts/ci.sh",
    "claim:check": "node scripts/claim-check.mjs",
    "chain:node": "node apps/chain/src/server.ts",
    "pretest": "npm run build:packages && npm run build:verifiers",
    "build:verifiers": "node scripts/build-verifiers.mjs",
    "dev:chess": "node apps/verifiers/chess/server.ts",
    "pin": "node apps/api/src/pin-server.ts",
    "net": "node scripts/run-storage-net.mjs",
    "testnet:rehearsal": "node scripts/testnet-rehearsal.mjs",
    "example:trac-identity": "node --experimental-strip-types examples/trac-identity/main.ts",
    "test:contracts": "node --test contracts/test/*.test.mjs",
    "audit:baseline": "node contracts/scripts/audit-baseline.mjs",
    "audit:package": "node contracts/scripts/audit-package.mjs",
    "audit:package:verify": "node contracts/scripts/audit-package.mjs --verify",
    "verify:deployment": "node contracts/scripts/verify-deployment-record.mjs",
    "deploy:anchor": "node contracts/scripts/deploy-anchor.mjs",
    "deploy:anchor:testnet": "node contracts/scripts/deploy-anchor-testnet.mjs",
    "demo:ai": "node scripts/demo-ai-on-rarext.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@ethereumjs/vm": "10.1.3",
    "@openzeppelin/contracts": "5.0.2",
    "@openzeppelin/contracts-upgradeable": "5.0.2",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "ethers": "6.17.0",
    "solc": "0.8.38",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
